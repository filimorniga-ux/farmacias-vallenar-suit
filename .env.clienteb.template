# ============================================================
# .env.clienteb — Variables para Demo de Cliente B
# Copiar como .env.production en el deploy del Cliente B
# ============================================================

# ─── MARCA ───────────────────────────────────────────────────
# ⬇ Personalizar con la marca del nuevo cliente
NEXT_PUBLIC_BRAND_NAME=Farmacia Demo
NEXT_PUBLIC_BRAND_SUBTITLE=SUITE GESTIÓN V1.0
NEXT_PUBLIC_BRAND_COLOR=#059669
NEXT_PUBLIC_BRAND_LOGO=/logo-horizontal.png
NEXT_PUBLIC_BRAND_LOGO_ICON=/icon.png
NEXT_PUBLIC_BRAND_SHORT_NAME=Farmacia Demo
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tu-agencia.cl

# ─── BASE DE DATOS ────────────────────────────────────────────
# (Completar con las credenciales del nuevo proyecto Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# ─── SUPABASE ────────────────────────────────────────────────
# (Crear nuevo proyecto en supabase.com y pegar aquí)
NEXT_PUBLIC_SUPABASE_URL=https://NUEVO_PROYECTO_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_CLIENTE_B

# ─── NEXT ────────────────────────────────────────────────────
NEXT_IMAGE_UNOPTIMIZED=true
NODE_ENV=production
