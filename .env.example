# DATABASE (Tiger Cloud PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# APPLICATION
APP_ENV=staging
NODE_ENV=production
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
HEALTHCHECK_TOKEN=replace-with-random-token

# Reglas:
# - APP_ENV=staging permite la cuenta DEV controlada y recursos de prueba.
# - APP_ENV=production exige recursos reales y la cuenta DEV desactivada.
# - NODE_ENV sigue siendo production en despliegues optimizados de Next.js, incluso en staging.

# OPTIONAL: Additional Services
# AI_DEEPSEEK_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_DEEPSEEK_OCR_ENDPOINT=https://your-domain.com/api/ai/deepseek-ocr
# AI_INTERNAL_ENDPOINT_TOKEN=replace-with-random-internal-token
# AI_DEEPSEEK_OCR_UPSTREAM_URL=https://api.deepseek.com/chat/completions
# NEXT_PUBLIC_STRIPE_KEY=pk_live_...
# NEXT_PUBLIC_ANALYTICS_ID=...
